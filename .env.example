# Vorlage für .env.local (nicht committen). Der Build bricht ab, wenn einer der
# drei Werte fehlt, leer ist oder Leerzeichen am Rand hat. Es sind öffentliche Werte (landen im Bundle), keine Geheimnisse.
# Quelle: EmailJS-Dashboard, Service, Template und Account > General > Public Key.

# Kontaktformular (EmailJS). Der Empfänger steht fest im Template, nicht hier.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
